{
  "name": "vedoy-booking",
  "version": "0.1.0",
  "description": "Dependency-free booking, availability and conflict utilities for Node.js and TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": ["booking", "availability", "appointments", "scheduling", "vedoy"],
  "author": "Vedøy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandervedoy/vedoy-booking.git"
  },
  "bugs": { "url": "https://github.com/leandervedoy/vedoy-booking/issues" },
  "homepage": "https://github.com/leandervedoy/vedoy-booking#readme",
  "engines": { "node": ">=18" },
  "devDependencies": { "typescript": "5.6.3" }
}

